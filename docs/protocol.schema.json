{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "τ wire protocol",
  "description": "JSON-RPC 2.0, one message per WebSocket text message (D21).",
  "x-protocol": 1,
  "$defs": {
    "Appended": {
      "description": "Nodes added to the tree, in id order, bodies included.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "Appended"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      },
      "required": [
        "kind",
        "nodes"
      ]
    },
    "Author": {
      "oneOf": [
        {
          "enum": [
            "Provider",
            "Tools",
            "Core"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Frontend": {
              "type": "string"
            }
          },
          "required": [
            "Frontend"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Extension": {
              "type": "string"
            }
          },
          "required": [
            "Extension"
          ],
          "type": "object"
        }
      ]
    },
    "Body": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "System": {
              "type": "string"
            }
          },
          "required": [
            "System"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "User": {
              "type": "string"
            }
          },
          "required": [
            "User"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Assistant": {
              "properties": {
                "finish_reason": {
                  "description": "The provider's own finish string, verbatim; `None` when it sent none\n(an interrupted reply, a failed sample).",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "meta": {
                  "default": null,
                  "description": "What the response carried besides its parts (model, id, usage...), as JSON\nobject text. Opaque to core; `None` when the provider sent none.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "parts": {
                  "items": {
                    "$ref": "#/$defs/Part"
                  },
                  "type": "array"
                },
                "stop": {
                  "$ref": "#/$defs/Stop"
                }
              },
              "required": [
                "parts",
                "stop"
              ],
              "type": "object"
            }
          },
          "required": [
            "Assistant"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One `(call id, outcome, by)` per call, in call order. `by` is who\nproduced that outcome: `Tools`, or the extension that answered or edited it.",
          "properties": {
            "Results": {
              "items": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/Outcome"
                  },
                  {
                    "$ref": "#/$defs/Author"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "Results"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Config": {
              "$ref": "#/$defs/Config"
            }
          },
          "required": [
            "Config"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Custom": {
              "properties": {
                "data": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "data"
              ],
              "type": "object"
            }
          },
          "required": [
            "Custom"
          ],
          "type": "object"
        }
      ]
    },
    "CallArgs": {
      "description": "More of call `index`'s argument text (`args_raw`).",
      "type": "object",
      "properties": {
        "kind": {
          "const": "CallArgs"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "index",
        "text"
      ]
    },
    "CallNamed": {
      "description": "A call begins forming: call number `index` in this reply, with its `id` and tool.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "CallNamed"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "index",
        "id",
        "tool"
      ]
    },
    "Config": {
      "description": "A config snapshot. `data` is opaque to core and typed by the driver.",
      "properties": {
        "data": {
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "type": "object"
    },
    "CursorGone": {
      "description": "Cursor `cursor` is closed (D17): a client drops its view of it. `at` is the node it was\nlast at, for restarting (`reopen`). A cursor has one state event at a time: its `CursorView`\nwhile open, this after it closes. Labels may still name it: they are its restart record.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "CursorGone"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "cursor",
        "at"
      ]
    },
    "CursorView": {
      "description": "One cursor as a client sees it, whole: where it is (`at`), whether a step is running\n(`busy`), `auto`-step, its open `questions` (oldest first), its pending `items` (an\n`ItemData.Input` says who wrote it: its `by`), and how its last step ended (`ending`) with the\n`hook_error` that ended it, if a cursor hook failed in\nit. Both are `None` from the start of a step until it ends, and after a reload. `model` is the\nqualified name of the model the cursor's branch is on (what its next sample uses), `None` if\nno `Config` on the branch names one or one is unreadable (a sample says which). `shown` is\nwhat each extension shows on the cursor (`Cursor.show`), as `(extension, text)` pairs in\nextension-name order; it is not in the log, so it is empty after a reload.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "CursorView"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "busy": {
          "type": "boolean"
        },
        "auto": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenQuestion"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "ending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ending"
            },
            {
              "type": "null"
            }
          ]
        },
        "hook_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "shown": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "kind",
        "cursor",
        "at",
        "busy",
        "auto",
        "questions",
        "items",
        "ending",
        "hook_error",
        "model",
        "shown"
      ]
    },
    "End": {
      "description": "The params of the last message: the notification `end`. `error` is null when the driver stopped, else `CutOff` or `Stopped`.",
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Error"
            }
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "Ending": {
      "description": "How a step ended. Serde-encoded as the nodes are: it crosses the wire in a `CursorView`.",
      "oneOf": [
        {
          "enum": [
            "Done",
            "Aborted"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Halted": {
              "type": "string"
            }
          },
          "required": [
            "Halted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Failed": {
              "type": "string"
            }
          },
          "required": [
            "Failed"
          ],
          "type": "object"
        }
      ]
    },
    "Error": {
      "description": "A JSON-RPC error object; `data` holds what a row needs to rebuild its exception (`ProtocolMismatch`: `server`; `UnknownCommand`: `name`).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "description": "The error table (D21 section 5).",
      "type": "integer",
      "enum": [
        -32700,
        -32600,
        -32601,
        -32602,
        -32603,
        -32001,
        -32002,
        -32003,
        -32004,
        -32005,
        -32006,
        -32007,
        -32008,
        -32009,
        -32010,
        -32011,
        -32012,
        -32013,
        -32014
      ],
      "x-names": [
        "ParseError",
        "InvalidRequest",
        "MethodNotFound",
        "InvalidParams",
        "Internal",
        "Busy",
        "NoSuchCursor",
        "CursorClosed",
        "NoSuchNode",
        "NoSuchLabel",
        "ProtocolMismatch",
        "NotFound",
        "UnknownCommand",
        "Refused",
        "NotYours",
        "CommandFailed",
        "ConfigError",
        "Stopped",
        "CutOff"
      ],
      "x-raises": [
        "ProtocolError",
        "ProtocolError",
        "ProtocolError",
        "TypeError",
        "RuntimeError",
        "Busy",
        "NoSuchCursor",
        "CursorClosed",
        "NoSuchNode",
        "NoSuchLabel",
        "ProtocolMismatch",
        "LookupError",
        "UnknownCommand",
        "ValueError",
        "PermissionError",
        "CommandFailed",
        "ConfigError",
        "ConnectionError",
        "CutOff"
      ]
    },
    "Event": {
      "description": "The params of the notification `event`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Live"
        },
        {
          "$ref": "#/$defs/CursorView"
        },
        {
          "$ref": "#/$defs/CursorGone"
        },
        {
          "$ref": "#/$defs/Labels"
        },
        {
          "$ref": "#/$defs/Appended"
        },
        {
          "$ref": "#/$defs/Notice"
        }
      ]
    },
    "Form": {
      "description": "What a client knows of something it fills in: a command (its `name`, typed as `/name`,\nits `description` and the `schema` of its arguments, with the named types' `\"format\"` and\neach default, and the `extension` that owns it) or an extension's options (the `name` of the\nextension, and a `schema` whose defaults are the values now; `extension` is `None`, as it is\nfor `/config`). A command is called by its `qualified` name, `extension:name`, which on the\nwire a client writes itself from the two fields. A command that `yields` gives its bare name\nup to any other command that has it (`/model` stays the built-in's; the yielding one is only\n`/skills:model`). Frozen, compared by value, and not hashable:\nthe schema is a dict.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "yields": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "schema"
      ]
    },
    "HookFailure": {
      "description": "A cursor hook of `extension` raised, or broke its contract, at hook `point`\n(`\"pre_step\"`, `\"post_step\"`, ...). `error` is `\"Type: msg\"`, the text a `post_step` hook\nsees in `Ending.Failed`.",
      "type": "object",
      "properties": {
        "extension": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "extension",
        "point",
        "error"
      ]
    },
    "Item": {
      "properties": {
        "data": {
          "$ref": "#/$defs/ItemData"
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "to",
        "data"
      ],
      "type": "object"
    },
    "ItemData": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Input": {
              "properties": {
                "by": {
                  "$ref": "#/$defs/Author"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "by",
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "Input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Extension": {
              "properties": {
                "data": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "data"
              ],
              "type": "object"
            }
          },
          "required": [
            "Extension"
          ],
          "type": "object"
        }
      ]
    },
    "Labels": {
      "description": "Every label and the cursor it is on, in label order.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "Labels"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "kind",
        "labels"
      ]
    },
    "Live": {
      "description": "A delta, on the cursor whose sample or tool call produced it. Never in the tree: a client\ndraws it as a layer over the cursor. Only a client watching the cursor hears it.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "Live"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextDelta"
            },
            {
              "$ref": "#/$defs/ThinkingDelta"
            },
            {
              "$ref": "#/$defs/CallNamed"
            },
            {
              "$ref": "#/$defs/CallArgs"
            },
            {
              "$ref": "#/$defs/Retrying"
            },
            {
              "$ref": "#/$defs/ToolProgress"
            }
          ]
        }
      },
      "required": [
        "kind",
        "cursor",
        "delta"
      ]
    },
    "Node": {
      "properties": {
        "body": {
          "$ref": "#/$defs/Body"
        },
        "by": {
          "$ref": "#/$defs/Author"
        },
        "copied_from": {
          "description": "The node this one repeats verbatim (a compaction or prune copy). A log written\nbefore this field existed has none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "delivers": {
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "derived_from": {
          "description": "The node whose walk this one's content was computed from (a summary, a pruned\ntranscript). A log written before this field existed has none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "time": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "typed": {
          "description": "What a person typed, for a `User` node whose text a `pre_input` hook changed (the\nattachments extension inlines files). Set only when it differs from the text: the\nnode's `body` is what the model sees, this is what to put back in an editor. A log\nwritten before this field existed has none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "time",
        "by",
        "body",
        "delivers"
      ],
      "type": "object"
    },
    "Notice": {
      "description": "A message for one client, or for all of them: `cursor.tell` (to every client unless it\nnames one), or an input a hook refused (to its author).",
      "type": "object",
      "properties": {
        "kind": {
          "const": "Notice"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "OpenQuestion": {
      "description": "A question an extension asked and nobody has answered: `id` (what `answer` names), whom\nit is for (`to`: a client id, `None` for anyone), the `extension` that asked, what it asks,\nand the JSON Schema of the answer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extension": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "to",
        "extension",
        "text",
        "schema"
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "enum": [
            "Interrupted"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Ok": {
              "type": "string"
            }
          },
          "required": [
            "Ok"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Err": {
              "type": "string"
            }
          },
          "required": [
            "Err"
          ],
          "type": "object"
        }
      ]
    },
    "Parsed": {
      "description": "A command line, read: the `command` form, its `args` (decoded JSON), and the `missing`\nrequired parameters, in order, which a frontend asks for. For `/config <extension>` the\n`command` is the extension's options form, `args` the options to change and `extension`\nits name; with no `args` the line asks for the form, which a frontend shows from\n`Client.options`. `save` is whether `--save` was typed. `run` makes the call.",
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/Form"
        },
        "args": {
          "type": "object"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "save": {
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "args",
        "missing"
      ]
    },
    "Part": {
      "description": "One piece of a reply. `replay` is `None` unless the provider kept data to\nsend back. Logs written before replay existed load as `None`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Text": {
              "$ref": "#/$defs/Prose"
            }
          },
          "required": [
            "Text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Thinking": {
              "$ref": "#/$defs/Prose"
            }
          },
          "required": [
            "Thinking"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Call": {
              "properties": {
                "args_raw": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "replay": {
                  "$ref": "#/$defs/Replay"
                },
                "tool": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "tool",
                "args_raw"
              ],
              "type": "object"
            }
          },
          "required": [
            "Call"
          ],
          "type": "object"
        }
      ]
    },
    "Prose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "properties": {
            "replay": {
              "$ref": "#/$defs/Replay"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "replay"
          ],
          "type": "object"
        }
      ],
      "description": "A string is plain; an object is signed. Deserialized by hand because\n`untagged` would drop the reason a bad replay was refused."
    },
    "Replay": {
      "description": "Data only the provider that wrote a part can send back (a signature, a\nredacted block). `data` is the text of a JSON object with no repeated key,\nkept exactly as given and opaque to core beyond that; `provider` names who\nmay send it back.",
      "properties": {
        "data": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "data"
      ],
      "type": "object"
    },
    "Retrying": {
