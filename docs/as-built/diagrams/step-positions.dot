// Generated by scripts/diagrams.sh from the test suites' transitions. Do not edit.
digraph step_positions {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.6, labelloc=t, label=<<b>One step: positions, the job each hands out, the answer each edge waits for</b><br/>edge label = what causes the move, then the number of scenarios that made it; dashed red = the code allows it, no scenario makes it; orange = only the property tests make it>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  "(wake)" [shape=circle, label="wake", fontsize=10];
  "PreStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreStep</b></td></tr><tr><td align="left"><font point-size="9">pre_step hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreStep) (222)</font></td></tr></table>>];
  "Input" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Input</b></td></tr><tr><td align="left"><font point-size="9">input phase: pre_input hooks, then commit a User node, per pending input</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreInput) (167)</font></td></tr></table>>];
  "PreSample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreSample</b></td></tr><tr><td align="left"><font point-size="9">pre_sample hooks (if a sample applies)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreSample) (154)</font></td></tr></table>>];
  "Sample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Sample</b></td></tr><tr><td align="left"><font point-size="9">the provider sample</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Sample (150)</font></td></tr></table>>];
  "PreReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreReply</b></td></tr><tr><td align="left"><font point-size="9">pre_reply hooks on the reply draft, then commit the Assistant node</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreReply) (130)</font></td></tr></table>>];
  "PostReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostReply</b></td></tr><tr><td align="left"><font point-size="9">post_reply hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostReply) (123)</font></td></tr></table>>];
  "Tools" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Tools</b></td></tr><tr><td align="left"><font point-size="9">decide whether a batch runs (no job of its own)</font></td></tr></table>>];
  "Calls" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Calls</b></td></tr><tr><td align="left"><font point-size="9">the tool calls run in the driver; outcomes arrive one by one</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out RunCalls (66)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Pending (13)</font></td></tr></table>>];
  "PostResult" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostResult</b></td></tr><tr><td align="left"><font point-size="9">post_result hooks, after the Results node is written</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostResult) (53)</font></td></tr></table>>];
  "PostStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostStep</b></td></tr><tr><td align="left"><font point-size="9">post_step hooks, carrying the ending</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Done) (132)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Halted) (7)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Failed) (50)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Aborted) (24)</font></td></tr></table>>];
  "Rest" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Rest</b></td></tr><tr><td align="left"><font point-size="9">the step has ended</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Rest (54)</font></td></tr></table>>];
  "(wake)" -> "PreStep" [label=<wake (189)<br/>wake (asked) (39)>, color="black", style=solid];
  "Calls" -> "Calls" [label=<answer CallDone (14)>, color="black", style=solid];
  "Calls" -> "PostResult" [label=<answer CallDone (54)>, color="black", style=solid];
  "Input" -> "Input" [label=<answer Hooks (161)>, color="black", style=solid];
  "Input" -> "PostStep" [label=<answer HookFailed (3)<br/>answer Hooks(stop) (2)<br/>commit refused (3)>, color="black", style=solid];
  "Input" -> "PreSample" [label=<no input to offer (199)>, color="black", style=solid];
  "PostReply" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (13)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostReply" -> "Tools" [label=<answer Hooks (109)>, color="black", style=solid];
  "PostResult" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (51)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostStep" -> "PreStep" [label=<ending Done (63)>, color="black", style=solid];
  "PostStep" -> "Rest" [label=<ending Aborted (24)<br/>ending Done (129)<br/>ending Failed (50)<br/>ending Halted (7)>, color="black", style=solid];
  "PreReply" -> "PostReply" [label=<answer Hooks (123)>, color="black", style=solid];
  "PreReply" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks(stop) (2)<br/>commit refused (4)>, color="black", style=solid];
  "PreSample" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PreSample" -> "Sample" [label=<answer Hooks (152)>, color="black", style=solid];
  "PreSample" -> "Tools" [label=<sample does not apply (63)>, color="black", style=solid];
  "PreStep" -> "Input" [label=<answer Hooks (207)>, color="black", style=solid];
  "PreStep" -> "PostStep" [label=<answer HookFailed (12)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "Sample" -> "PostStep" [label=<answer Sampled(error) (13)<br/>answer Sampled(none) (5)>, color="black", style=solid];
  "Sample" -> "PreReply" [label=<answer Sampled(reply) (117)<br/>answer Sampled(reply, error) (13)<br/>pre_sample draft answers the sample (2)>, color="black", style=solid];
  "Tools" -> "Calls" [label=<tools apply (66)>, color="black", style=solid];
  "Tools" -> "PostStep" [label=<tools do not apply (136)>, color="black", style=solid];
}
