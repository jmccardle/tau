// Generated by scripts/diagrams.sh from the test suites' transitions. Do not edit.
digraph step_positions {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.6, labelloc=t, label=<<b>One step: positions, the job each hands out, the feed each edge waits for</b><br/>edge label = what causes the move, then the number of scenarios that made it; dashed red = the code allows it, no scenario makes it; orange = only the property tests make it>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  "(wake)" [shape=circle, label="wake", fontsize=10];
  "PreStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreStep</b></td></tr><tr><td align="left"><font point-size="9">pre_step hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreStep) (132)</font></td></tr></table>>];
  "Input" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Input</b></td></tr><tr><td align="left"><font point-size="9">input phase: pre_input hooks, then commit a User node, per pending input</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreInput) (97)</font></td></tr></table>>];
  "PreSample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreSample</b></td></tr><tr><td align="left"><font point-size="9">pre_sample hooks (if a sample applies)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreSample) (87)</font></td></tr></table>>];
  "Sample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Sample</b></td></tr><tr><td align="left"><font point-size="9">the provider sample</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Sample (84)</font></td></tr></table>>];
  "PreReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreReply</b></td></tr><tr><td align="left"><font point-size="9">pre_reply hooks on the reply draft, then commit the Assistant node</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreReply) (77)</font></td></tr></table>>];
  "PostReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostReply</b></td></tr><tr><td align="left"><font point-size="9">post_reply hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostReply) (74)</font></td></tr></table>>];
  "Tools" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Tools</b></td></tr><tr><td align="left"><font point-size="9">decide whether a batch runs (no job of its own)</font></td></tr></table>>];
  "Calls" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Calls</b></td></tr><tr><td align="left"><font point-size="9">the tool calls run in the driver; outcomes arrive one by one</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out RunCalls (39)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Pending (8)</font></td></tr></table>>];
  "PostResult" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostResult</b></td></tr><tr><td align="left"><font point-size="9">post_result hooks, after the Results node is written</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostResult) (32)</font></td></tr></table>>];
  "PostStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostStep</b></td></tr><tr><td align="left"><font point-size="9">post_step hooks, carrying the ending</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Done) (99)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Halted) (5)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Failed) (10)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Aborted) (11)</font></td></tr></table>>];
  "Throttle" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Throttle</b></td></tr><tr><td align="left"><font point-size="9">wait 250 ms before the next step (nothing was committed)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Wait (11)</font></td></tr></table>>];
  "Rest" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Rest</b></td></tr><tr><td align="left"><font point-size="9">the step has ended</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Rest (116)</font></td></tr></table>>];
  "(wake)" -> "PreStep" [label=<wake (106)<br/>wake (asked) (18)>, color="black", style=solid];
  "Calls" -> "Calls" [label=<feed CallDone (15)>, color="black", style=solid];
  "Calls" -> "PostResult" [label=<feed CallDone (33)>, color="black", style=solid];
  "Input" -> "Input" [label=<feed Hooks (89)<br/>input delivered by a hook (3)>, color="black", style=solid];
  "Input" -> "PostStep" [label=<commit refused (2)<br/><font color="darkorange">feed HookFailed (1)</font><br/>feed Hooks(stop) (4)>, color="black", style=solid];
  "Input" -> "PreSample" [label=<no input to offer (121)>, color="black", style=solid];
  "PostReply" -> "PostStep" [label=<<font color="darkorange">feed HookFailed (1)</font><br/>feed Hooks (1)<br/><font color="darkorange">feed Hooks(stop) (1)</font>>, color="black", style=solid];
  "PostReply" -> "Tools" [label=<feed Hooks (73)>, color="black", style=solid];
  "PostResult" -> "PostStep" [label=<<font color="darkorange">feed HookFailed (1)</font><br/>feed Hooks (32)<br/><font color="darkorange">feed Hooks(stop) (1)</font>>, color="black", style=solid];
  "PostStep" -> "PreStep" [label=<ending Done (29)>, color="black", style=solid];
  "PostStep" -> "Rest" [label=<ending Aborted (11)<br/>ending Done (94)<br/>ending Failed (10)<br/>ending Halted (5)>, color="black", style=solid];
  "PostStep" -> "Throttle" [label=<ending Done (11)>, color="black", style=solid];
  "PreReply" -> "PostReply" [label=<feed Hooks (74)>, color="black", style=solid];
  "PreReply" -> "PostStep" [label=<commit refused (2)<br/><font color="darkorange">feed HookFailed (1)</font><br/><font color="darkorange">feed Hooks(stop) (1)</font>>, color="black", style=solid];
  "PreSample" -> "PostStep" [label=<<font color="darkorange">feed HookFailed (1)</font><br/>feed Hooks(stop) (2)>, color="black", style=solid];
  "PreSample" -> "Sample" [label=<feed Hooks (86)>, color="black", style=solid];
  "PreSample" -> "Tools" [label=<sample does not apply (50)>, color="black", style=solid];
  "PreStep" -> "Input" [label=<feed Hooks (128)>, color="black", style=solid];
  "PreStep" -> "PostStep" [label=<feed HookFailed (2)<br/><font color="darkorange">feed Hooks(stop) (1)</font>>, color="black", style=solid];
  "Sample" -> "PostStep" [label=<feed Sampled(error) (4)<br/>feed Sampled(none) (5)>, color="black", style=solid];
  "Sample" -> "PreReply" [label=<feed Sampled(reply) (75)<br/>feed Sampled(reply, error) (1)<br/>pre_sample draft answers the sample (2)>, color="black", style=solid];
  "Throttle" -> "PreStep" [label=<feed Waited (7)>, color="black", style=solid];
  "Throttle" -> "Rest" [label=<abort (4)>, color="black", style=solid];
  "Tools" -> "Calls" [label=<tools apply (39)>, color="black", style=solid];
  "Tools" -> "PostStep" [label=<tools do not apply (98)>, color="black", style=solid];
}
