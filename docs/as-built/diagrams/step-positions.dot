// Generated by scripts/diagrams.sh from the test suites' transitions. Do not edit.
digraph step_positions {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.6, labelloc=t, label=<<b>One step: positions, the job each hands out, the answer each edge waits for</b><br/>edge label = what causes the move, then the number of scenarios that made it; dashed red = the code allows it, no scenario makes it; orange = only the property tests make it>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  "(wake)" [shape=circle, label="wake", fontsize=10];
  "PreStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreStep</b></td></tr><tr><td align="left"><font point-size="9">pre_step hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreStep) (1564)</font></td></tr></table>>];
  "Input" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Input</b></td></tr><tr><td align="left"><font point-size="9">input phase: pre_input hooks, then commit a User node, per pending input</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreInput) (1313)</font></td></tr></table>>];
  "PreSample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreSample</b></td></tr><tr><td align="left"><font point-size="9">pre_sample hooks (if a sample applies)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreSample) (1281)</font></td></tr></table>>];
  "Sample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Sample</b></td></tr><tr><td align="left"><font point-size="9">the provider sample</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Sample (1257)</font></td></tr></table>>];
  "PreReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreReply</b></td></tr><tr><td align="left"><font point-size="9">pre_reply hooks on the reply draft, then commit the Assistant node</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreReply) (1186)</font></td></tr></table>>];
  "PostReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostReply</b></td></tr><tr><td align="left"><font point-size="9">post_reply hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostReply) (1165)</font></td></tr></table>>];
  "Tools" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Tools</b></td></tr><tr><td align="left"><font point-size="9">decide whether a batch runs (no job of its own)</font></td></tr></table>>];
  "Calls" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Calls</b></td></tr><tr><td align="left"><font point-size="9">the tool calls run in the driver; outcomes arrive one by one</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out RunCalls (682)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Pending (86)</font></td></tr></table>>];
  "PostResult" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostResult</b></td></tr><tr><td align="left"><font point-size="9">post_result hooks, after the Results node is written</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostResult) (574)</font></td></tr></table>>];
  "PostStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostStep</b></td></tr><tr><td align="left"><font point-size="9">post_step hooks, carrying the ending</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Done) (1226)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Halted) (15)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Failed) (180)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Aborted) (91)</font></td></tr></table>>];
  "Rest" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Rest</b></td></tr><tr><td align="left"><font point-size="9">the step has ended</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Rest (68)</font></td></tr></table>>];
  "(wake)" -> "PreStep" [label=<wake (1392)<br/>wake (asked) (312)>, color="black", style=solid];
  "Calls" -> "Calls" [label=<answer CallDone (87)>, color="black", style=solid];
  "Calls" -> "PostResult" [label=<answer CallDone (575)>, color="black", style=solid];
  "Input" -> "Input" [label=<answer Hooks (1294)>, color="black", style=solid];
  "Input" -> "PostStep" [label=<answer HookFailed (6)<br/>answer Hooks(stop) (8)<br/>commit refused (5)>, color="black", style=solid];
  "Input" -> "PreSample" [label=<no input to offer (1498)>, color="black", style=solid];
  "PostReply" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (27)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostReply" -> "Tools" [label=<answer Hooks (1138)>, color="black", style=solid];
  "PostResult" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (572)<br/>answer Hooks(stop) (1)>, color="black", style=solid];
  "PostStep" -> "PreStep" [label=<ending Done (696)>, color="black", style=solid];
  "PostStep" -> "Rest" [label=<ending Aborted (91)<br/>ending Done (1213)<br/>ending Failed (176)<br/>ending Halted (15)>, color="black", style=solid];
  "PreReply" -> "PostReply" [label=<answer Hooks (1165)>, color="black", style=solid];
  "PreReply" -> "PostStep" [label=<answer HookFailed (4)<br/>answer Hooks(stop) (2)<br/>commit refused (7)<br/>reply dropped (2)>, color="black", style=solid];
  "PreReply" -> "Tools" [label=<reply dropped (6)>, color="black", style=solid];
  "PreSample" -> "PostStep" [label=<answer HookFailed (36)<br/>answer Hooks(stop) (4)>, color="black", style=solid];
  "PreSample" -> "Sample" [label=<answer Hooks (1263)>, color="black", style=solid];
  "PreSample" -> "Tools" [label=<sample does not apply (486)>, color="black", style=solid];
  "PreStep" -> "Input" [label=<answer Hooks (1516)>, color="black", style=solid];
  "PreStep" -> "PostStep" [label=<answer HookFailed (45)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "Sample" -> "PostStep" [label=<answer Sampled(error) (54)<br/>answer Sampled(none) (20)>, color="black", style=solid];
  "Sample" -> "PreReply" [label=<answer Sampled(reply) (1157)<br/>answer Sampled(reply, error) (29)<br/>pre_sample draft answers the sample (5)>, color="black", style=solid];
  "Sample" -> "Tools" [label=<aborted: no sample (6)>, color="black", style=solid];
  "Tools" -> "Calls" [label=<tools apply (682)>, color="black", style=solid];
  "Tools" -> "PostStep" [label=<tools do not apply (1246)>, color="black", style=solid];
}
