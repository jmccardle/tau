// Generated by scripts/diagrams.sh from the test suites' transitions. Do not edit.
digraph step_positions {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.6, labelloc=t, label=<<b>One step: positions, the job each hands out, the answer each edge waits for</b><br/>edge label = what causes the move, then the number of scenarios that made it; dashed red = the code allows it, no scenario makes it; orange = only the property tests make it>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  "(wake)" [shape=circle, label="wake", fontsize=10];
  "PreStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreStep</b></td></tr><tr><td align="left"><font point-size="9">pre_step hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreStep) (391)</font></td></tr></table>>];
  "Input" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Input</b></td></tr><tr><td align="left"><font point-size="9">input phase: pre_input hooks, then commit a User node, per pending input</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreInput) (267)</font></td></tr></table>>];
  "PreSample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreSample</b></td></tr><tr><td align="left"><font point-size="9">pre_sample hooks (if a sample applies)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreSample) (251)</font></td></tr></table>>];
  "Sample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Sample</b></td></tr><tr><td align="left"><font point-size="9">the provider sample</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Sample (245)</font></td></tr></table>>];
  "PreReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreReply</b></td></tr><tr><td align="left"><font point-size="9">pre_reply hooks on the reply draft, then commit the Assistant node</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreReply) (223)</font></td></tr></table>>];
  "PostReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostReply</b></td></tr><tr><td align="left"><font point-size="9">post_reply hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostReply) (215)</font></td></tr></table>>];
  "Tools" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Tools</b></td></tr><tr><td align="left"><font point-size="9">decide whether a batch runs (no job of its own)</font></td></tr></table>>];
  "Calls" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Calls</b></td></tr><tr><td align="left"><font point-size="9">the tool calls run in the driver; outcomes arrive one by one</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out RunCalls (105)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Pending (13)</font></td></tr></table>>];
  "PostResult" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostResult</b></td></tr><tr><td align="left"><font point-size="9">post_result hooks, after the Results node is written</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostResult) (92)</font></td></tr></table>>];
  "PostStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostStep</b></td></tr><tr><td align="left"><font point-size="9">post_step hooks, carrying the ending</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Done) (283)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Halted) (11)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Failed) (64)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Aborted) (36)</font></td></tr></table>>];
  "Rest" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Rest</b></td></tr><tr><td align="left"><font point-size="9">the step has ended</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Rest (61)</font></td></tr></table>>];
  "(wake)" -> "PreStep" [label=<wake (326)<br/>wake (asked) (91)>, color="black", style=solid];
  "Calls" -> "Calls" [label=<answer CallDone (14)>, color="black", style=solid];
  "Calls" -> "PostResult" [label=<answer CallDone (93)>, color="black", style=solid];
  "Input" -> "Input" [label=<answer Hooks (258)>, color="black", style=solid];
  "Input" -> "PostStep" [label=<answer HookFailed (3)<br/>answer Hooks(stop) (5)<br/>commit refused (3)>, color="black", style=solid];
  "Input" -> "PreSample" [label=<no input to offer (357)>, color="black", style=solid];
  "PostReply" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (13)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostReply" -> "Tools" [label=<answer Hooks (201)>, color="black", style=solid];
  "PostResult" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (90)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostStep" -> "PreStep" [label=<ending Done (107)>, color="black", style=solid];
  "PostStep" -> "Rest" [label=<ending Aborted (36)<br/>ending Done (276)<br/>ending Failed (60)<br/>ending Halted (11)>, color="black", style=solid];
  "PreReply" -> "PostReply" [label=<answer Hooks (215)>, color="black", style=solid];
  "PreReply" -> "PostStep" [label=<answer HookFailed (3)<br/>answer Hooks(stop) (2)<br/>commit refused (4)>, color="black", style=solid];
  "PreSample" -> "PostStep" [label=<answer HookFailed (4)<br/>answer Hooks(stop) (3)>, color="black", style=solid];
  "PreSample" -> "Sample" [label=<answer Hooks (247)>, color="black", style=solid];
  "PreSample" -> "Tools" [label=<sample does not apply (155)>, color="black", style=solid];
  "PreStep" -> "Input" [label=<answer Hooks (367)>, color="black", style=solid];
  "PreStep" -> "PostStep" [label=<answer HookFailed (20)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "Sample" -> "PostStep" [label=<answer Sampled(error) (16)<br/>answer Sampled(none) (5)>, color="black", style=solid];
  "Sample" -> "PreReply" [label=<answer Sampled(reply) (210)<br/>answer Sampled(reply, error) (13)<br/>pre_sample draft answers the sample (3)>, color="black", style=solid];
  "Tools" -> "Calls" [label=<tools apply (105)>, color="black", style=solid];
  "Tools" -> "PostStep" [label=<tools do not apply (289)>, color="black", style=solid];
}
