// Generated by scripts/diagrams.sh from the test suites' transitions. Do not edit.
digraph step_positions {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.6, labelloc=t, label=<<b>One step: positions, the job each hands out, the answer each edge waits for</b><br/>edge label = what causes the move, then the number of scenarios that made it; dashed red = the code allows it, no scenario makes it; orange = only the property tests make it>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  "(wake)" [shape=circle, label="wake", fontsize=10];
  "PreStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreStep</b></td></tr><tr><td align="left"><font point-size="9">pre_step hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreStep) (457)</font></td></tr></table>>];
  "Input" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Input</b></td></tr><tr><td align="left"><font point-size="9">input phase: pre_input hooks, then commit a User node, per pending input</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreInput) (325)</font></td></tr></table>>];
  "PreSample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreSample</b></td></tr><tr><td align="left"><font point-size="9">pre_sample hooks (if a sample applies)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreSample) (308)</font></td></tr></table>>];
  "Sample" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Sample</b></td></tr><tr><td align="left"><font point-size="9">the provider sample</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Sample (302)</font></td></tr></table>>];
  "PreReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PreReply</b></td></tr><tr><td align="left"><font point-size="9">pre_reply hooks on the reply draft, then commit the Assistant node</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PreReply) (269)</font></td></tr></table>>];
  "PostReply" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostReply</b></td></tr><tr><td align="left"><font point-size="9">post_reply hooks</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostReply) (257)</font></td></tr></table>>];
  "Tools" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Tools</b></td></tr><tr><td align="left"><font point-size="9">decide whether a batch runs (no job of its own)</font></td></tr></table>>];
  "Calls" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Calls</b></td></tr><tr><td align="left"><font point-size="9">the tool calls run in the driver; outcomes arrive one by one</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out RunCalls (107)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Pending (14)</font></td></tr></table>>];
  "PostResult" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostResult</b></td></tr><tr><td align="left"><font point-size="9">post_result hooks, after the Results node is written</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostResult) (94)</font></td></tr></table>>];
  "PostStep" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>PostStep</b></td></tr><tr><td align="left"><font point-size="9">post_step hooks, carrying the ending</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Done) (334)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Halted) (11)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Failed) (75)</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Hooks(PostStep, Aborted) (38)</font></td></tr></table>>];
  "Rest" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td align="left"><b>Rest</b></td></tr><tr><td align="left"><font point-size="9">the step has ended</font></td></tr><tr><td align="left"><font color="black" point-size="10">hands out Rest (62)</font></td></tr></table>>];
  "(wake)" -> "PreStep" [label=<wake (380)<br/>wake (asked) (106)>, color="black", style=solid];
  "Calls" -> "Calls" [label=<answer CallDone (15)>, color="black", style=solid];
  "Calls" -> "PostResult" [label=<answer CallDone (95)>, color="black", style=solid];
  "Input" -> "Input" [label=<answer Hooks (315)>, color="black", style=solid];
  "Input" -> "PostStep" [label=<answer HookFailed (4)<br/>answer Hooks(stop) (5)<br/>commit refused (3)>, color="black", style=solid];
  "Input" -> "PreSample" [label=<no input to offer (421)>, color="black", style=solid];
  "PostReply" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (14)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostReply" -> "Tools" [label=<answer Hooks (242)>, color="black", style=solid];
  "PostResult" -> "PostStep" [label=<answer HookFailed (2)<br/>answer Hooks (92)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "PostStep" -> "PreStep" [label=<ending Done (117)>, color="black", style=solid];
  "PostStep" -> "Rest" [label=<ending Aborted (38)<br/>ending Done (325)<br/>ending Failed (71)<br/>ending Halted (11)>, color="black", style=solid];
  "PreReply" -> "PostReply" [label=<answer Hooks (257)>, color="black", style=solid];
  "PreReply" -> "PostStep" [label=<answer HookFailed (3)<br/>answer Hooks(stop) (2)<br/>commit refused (4)<br/>reply dropped (1)>, color="black", style=solid];
  "PreReply" -> "Tools" [label=<reply dropped (3)>, color="black", style=solid];
  "PreSample" -> "PostStep" [label=<answer HookFailed (4)<br/>answer Hooks(stop) (3)>, color="black", style=solid];
  "PreSample" -> "Sample" [label=<answer Hooks (304)>, color="black", style=solid];
  "PreSample" -> "Tools" [label=<sample does not apply (170)>, color="black", style=solid];
  "PreStep" -> "Input" [label=<answer Hooks (432)>, color="black", style=solid];
  "PreStep" -> "PostStep" [label=<answer HookFailed (21)<br/>answer Hooks(stop) (2)>, color="black", style=solid];
  "Sample" -> "PostStep" [label=<answer Sampled(error) (23)<br/>answer Sampled(none) (6)>, color="black", style=solid];
  "Sample" -> "PreReply" [label=<answer Sampled(reply) (254)<br/>answer Sampled(reply, error) (15)<br/>pre_sample draft answers the sample (3)>, color="black", style=solid];
  "Tools" -> "Calls" [label=<tools apply (107)>, color="black", style=solid];
  "Tools" -> "PostStep" [label=<tools do not apply (340)>, color="black", style=solid];
}
