digraph G {
  rankdir=TB; node [shape=box, fontsize=10]; edge [fontsize=9];
  subgraph cluster_S1 { label="S1.jsonl (the only session file)"; class="durable";
    e02 [label="e02 system SYS"];
    e03 [label="e03 config"];
    e04 [label="e04 user: please delegate"];
    e05 [label="e05 assistant [call delegate]"];
    e06 [label="e06 config  src=agent\n(child frame: tools=[])"];
    e07 [label="e07 user: child task  src=agent"];
    e08 [label="e08 assistant: child: 3 files  src=agent"];
    e09 [label="e09 toolResult: child said: ..."];
    e10 [label="e10 assistant: parent: done"];
  }
  c1 [shape=hexagon, label="HEAD c1\nleaf e05 during spawn, e10 after", class="mark"];
  c2 [shape=hexagon, label="c2 owner=c1\nlive only inside spawn_branch", class="muted"];
  e02 -> e03 -> e04 -> e05 -> e09 -> e10;
  e04 -> e06 -> e07 -> e08;
  e08 -> e09 [label="result text copied by the tool's own return value", class="lazy", constraint=false];
  c1 -> e10 [class="soft", label="leaf"];
  c2 -> e08 [class="soft", label="leaf (closed)"];
}
