tabs: {{ tools[0].function.parameters.properties | tojson(indent='\t') }}
compact: {{ tools | tojson(separators=(',', ':')) }}
compact indented: {{ tools[0] | tojson(indent=1, separators=(',', ':')) }}
sorted: {{ tools | tojson(sort_keys=true) }}
ascii: {{ tools | tojson(ensure_ascii=true) }}
