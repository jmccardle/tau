{
  "method": "POST",
  "url": "https://api.mistral.ai/v1/chat/completions",
  "headers": {
    "content-type": "application/json",
    "accept": "*/*"
  },
  "body": {
    "model": "mistral-small-2603",
    "messages": [
      {
        "role": "system",
        "content": "Answer in one word."
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What colour is this image?"
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,"
            }
          }
        ]
      }
    ],
    "stream": true,
    "max_tokens": 2048,
    "stream_options": {
      "include_usage": true
    }
  }
}
