{
  "method": "POST",
  "url": "https://api.mistral.ai/v1/chat/completions",
  "headers": {
    "content-type": "application/json",
    "accept": "*/*"
  },
  "body": {
    "model": "mistral-small-2603",
    "messages": [
      {
        "role": "system",
        "content": "You describe colour swatches. Use show_swatch to see one before you answer."
      },
      {
        "role": "user",
        "content": "What colour is swatch S-1? Answer in one word."
      }
    ],
    "stream": true,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "show_swatch",
          "description": "Show one colour swatch by its id, as an image.",
          "parameters": {
            "type": "object",
            "properties": {
              "swatch": {
                "type": "string",
                "description": "a swatch id, like S-1"
              }
            },
            "required": [
              "swatch"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "max_tokens": 2048,
    "stream_options": {
      "include_usage": true
    }
  }
}
