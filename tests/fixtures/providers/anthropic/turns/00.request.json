{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "content-type": "application/json",
    "anthropic-version": "2023-06-01",
    "accept": "*/*"
  },
  "body": {
    "model": "claude-haiku-4-5",
    "max_tokens": 4096,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Look up part A-113 and tell me which bin it is in.",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ],
    "stream": true,
    "system": [
      {
        "type": "text",
        "text": "You are a parts clerk. Answer questions about parts only from what the lookup_part tool returns; never guess a part's details.",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "tools": [
      {
        "name": "lookup_part",
        "description": "Look up one part by its part number: what it is, its bin and its stock.",
        "input_schema": {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "description": "a part number, like A-113"
            }
          },
          "required": [
            "part"
          ],
          "additionalProperties": false
        }
      }
    ],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 1024
    }
  }
}
