{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "content-type": "application/json",
    "anthropic-version": "2023-06-01",
    "accept": "*/*"
  },
  "body": {
    "model": "claude-haiku-4-5",
    "max_tokens": 4096,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What colour is swatch S-1? Answer in one word.",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ],
    "stream": true,
    "system": [
      {
        "type": "text",
        "text": "You describe colour swatches. Use show_swatch to see one before you answer.",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "tools": [
      {
        "name": "show_swatch",
        "description": "Show one colour swatch by its id, as an image.",
        "input_schema": {
          "type": "object",
          "properties": {
            "swatch": {
              "type": "string",
              "description": "a swatch id, like S-1"
            }
          },
          "required": [
            "swatch"
          ],
          "additionalProperties": false
        }
      }
    ],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 1024
    }
  }
}
