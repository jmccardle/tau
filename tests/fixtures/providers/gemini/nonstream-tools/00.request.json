    "tools": [
      {
        "functionDeclarations": [
          {
            "name": "lookup_part",
            "description": "Look up one part by its part number: what it is, its bin and its stock.",
            "parametersJsonSchema": {
              "type": "object",
              "properties": {
                "part": {
                  "type": "string",
                  "description": "a part number, like A-113"
                }
              },
              "required": [
                "part"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    ]
  }
