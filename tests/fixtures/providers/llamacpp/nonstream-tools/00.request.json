{
  "method": "POST",
  "url": "http://llamacpp.invalid/v1/chat/completions",
  "headers": {
    "content-type": "application/json",
    "accept": "*/*"
  },
  "body": {
    "model": "qwen3.8-27b",
    "messages": [
      {
        "role": "system",
        "content": "You are a parts clerk. Answer questions about parts only from what the lookup_part tool returns; never guess a part's details."
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Look up part A-113."
          }
        ]
      }
    ],
    "stream": false,
    "max_tokens": 1024,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup_part",
          "description": "Look up one part by its part number: what it is, its bin and its stock.",
          "parameters": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "description": "a part number, like A-113"
              }
            },
            "required": [
              "part"
            ],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
