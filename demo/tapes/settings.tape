# Shared by every race tape. render.sh rewrites Width and Height for RES=1920x1080.
# Run vhs from the repository root with DEMO_WORK exported (render.sh does both).
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 8
Set Theme "Catppuccin Mocha"
Set Framerate 30
Set TypingSpeed 45ms
Set WaitTimeout 900s

Hide
Type "export PS1='$ ' && clear"
Enter
Sleep 500ms
Show
